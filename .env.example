# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Get a token from @BotFather on Telegram (required).
BOT_TOKEN=your-bot-token-here

# Optional. If set, Telegram must send this exact value in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook request.
# Set the same value as secret_token when you call setWebhook.
WEBHOOK_SECRET=

# Port the webhook server listens on (default 8080).
WEBHOOK_PORT=8080

# SQLite database file (default bot.db, created automatically).
DATABASE_PATH=bot.db

# Long-polling timeout in seconds (default 30).
POLLING_TIMEOUT=30
